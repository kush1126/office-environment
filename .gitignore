# Office OS — Git ignore

# ─── Secrets & Environment ────────────────────────────────────────────────────
.env
.env.local
.env.*.local


# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ─── Database ─────────────────────────────────────────────────────────────────
*.sqlite
*.db

# ─── Docker ───────────────────────────────────────────────────────────────────
# (docker-compose.yml IS committed — only override files are ignored)
docker-compose.override.yml

# ─── Storage & Uploads ────────────────────────────────────────────────────────
storage/
uploads/
backups/
logs/
documents/
company_data/
**/storage/
**/uploads/
**/backups/
**/logs/
**/documents/

# ─── AI Models & Vector Stores (Local Weights & Embeddings) ───────────────────
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
ai/models/
models/weights/
chroma/
vector_store/
embeddings/
*.duckdb

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Certificates & Keys ──────────────────────────────────────────────────────
*.pem
*.key
*.crt
*.csr

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
